# Copy to .env at the repository root. These settings are for local development.
DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-hosting
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:9000,capacitor://localhost,http://localhost
ALLOW_ELECTRON_FILE_ORIGIN=0
DATABASE_URL=postgresql://releaseholic:releaseholic@localhost:5432/releaseholic
CELERY_BROKER_URL=amqp://releaseholic:releaseholic@localhost:5672//
TMDB_TOKEN=
BANGUMI_TOKEN=
# Additional public hosts that the operator trusts for feeds and article imports.
ALLOWED_SOURCE_HOSTS=
ALLOWED_MODEL_HOSTS=
# Local model endpoints are disabled unless explicitly enabled by the operator.
ALLOW_LOCAL_MODELS=0
# Optional Fernet key. Otherwise derived from DJANGO_SECRET_KEY; preserve on restart.
MODEL_ENCRYPTION_KEY=
USER_AGENT=Release-Holic/0.1 (+https://github.com/Remi-Z/Release-Holic)
# Used only by compose.images.yaml for prebuilt container deployments.
BACKEND_IMAGE=ghcr.io/remi-z/release-holic-backend
WEB_IMAGE=ghcr.io/remi-z/release-holic-web
IMAGE_TAG=main
